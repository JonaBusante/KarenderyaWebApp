@page
@model KarenderyaWebApp.Pages.Admin.Dashboard.IndexModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid py-4 px-3 px-md-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1">Admin Dashboard</h2>
            <p class="text-muted mb-0">Welcome back! Here's what's happening today.</p>
        </div>

        <span class="badge bg-success-subtle text-success fs-6 px-3 py-2">
            <i class="bi bi-circle-fill me-1 small"></i> System Online
        </span>
    </div>

    <!-- Summary Cards -->
    <div class="row g-3 mb-4">

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Today's Sales</span>
                        <div class="rounded-3 bg-success-subtle text-success p-2">
                            <i class="bi bi-cash-stack fs-4"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1">₱0.00</h3>
                    <small class="text-muted">Total sales today</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Orders Today</span>
                        <div class="rounded-3 bg-primary-subtle text-primary p-2">
                            <i class="bi bi-receipt fs-4"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1">0</h3>
                    <small class="text-muted">Orders received today</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Menu Items</span>
                        <div class="rounded-3 bg-warning-subtle text-warning p-2">
                            <i class="bi bi-egg-fried fs-4"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1">0</h3>
                    <small class="text-muted">Available menu items</small>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-muted">Cashiers</span>
                        <div class="rounded-3 bg-info-subtle text-info p-2">
                            <i class="bi bi-people fs-4"></i>
                        </div>
                    </div>
                    <h3 class="fw-bold mb-1">0</h3>
                    <small class="text-muted">Registered cashiers</small>
                </div>
            </div>
        </div>

    </div>

    <!-- Quick Actions -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="fw-bold mb-3">Quick Actions</h5>

            <div class="row g-3">
                <div class="col-12 col-md-4">
                    <a asp-page="/Admin/Menu/Index"
                       class="btn btn-outline-success w-100 py-3">
                        <i class="bi bi-egg-fried me-2"></i>
                        Manage Menu
                    </a>
                </div>

                <div class="col-12 col-md-4">
                    <a asp-page="/Admin/Cashier/Index"
                       class="btn btn-outline-success w-100 py-3">
                        <i class="bi bi-person-plus me-2"></i>
                        Manage Cashiers
                    </a>
                </div>

                <div class="col-12 col-md-4">
                    <a asp-page="/Admin/Reports/Index"
                       class="btn btn-outline-success w-100 py-3">
                        <i class="bi bi-bar-chart me-2"></i>
                        View Sales Reports
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Orders -->
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white border-0 px-4 pt-4">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="fw-bold mb-0">Recent Orders</h5>
                <a asp-page="/Dashboard/Admin/Orders"
                   class="btn btn-sm btn-outline-success">
                    View All
                </a>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table align-middle table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Order #</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td colspan="5" class="text-center py-5 text-muted">
                                <i class="bi bi-receipt fs-1 d-block mb-2"></i>
                                No orders available yet.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
