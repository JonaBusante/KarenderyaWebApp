@page
@model KarenderyaWebApp.Pages.Cashier.CreateOrders.IndexModel

@{
    ViewData["Title"] = "Create Order";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Create Order</h2>
            <p class="text-muted mb-0">Select food items and enter quantities.</p>
        </div>

        <a asp-page="/Cashier/Dashboard/Index" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <div asp-validation-summary="All"></div>
        </div>
    }

    <form method="post" id="orderForm">
        @Html.AntiForgeryToken()

        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Available Menu</h5>
            </div>

            <div class="card-body">
                @if (Model.FoodItems.Count == 0)
                {
                    <div class="alert alert-warning mb-0">
                        No available food items or stock at the moment.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Food Item</th>
                                    <th class="text-end">Price</th>
                                    <th class="text-center">Available Stock</th>
                                    <th style="width: 150px;">Quantity</th>
                                    <th class="text-end">Subtotal</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var food in Model.FoodItems)
                                {
                                    <tr>
                                        <td class="fw-semibold">@food.Name</td>

                                        <td class="text-end"> ₱@food.Price.ToString("N2") </td>
                                        <td class="text-center"> <span class="badge bg-success"> @food.AvailableQuantity</span> </td>
                                        <td>
                                            <input type="number" class="form-control quantity-input" name="Quantities[@food.FoodItemId]" value="0" min="0" max="@food.AvailableQuantity"
                                            step="1" data-price="@food.Price" data-stock="@food.AvailableQuantity" aria-label="Quantity for @food.Name" />
                                        </td>
                                        <td class="text-end"> ₱<span class="item-subtotal">0.00</span> </td>
                                    </tr>
                                }
                            </tbody>

                            <tfoot>
                                <tr>
                                    <th colspan="4" class="text-end">Total Amount</th>
                                    <th class="text-end">
                                        <span class="fs-5"> ₱<span id="totalAmount">0.00</span></span>
                                    </th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="d-flex justify-content-end mt-3">
                        <button type="submit" class="btn btn-primary btn-lg">
                            Create Order
                        </button>
                    </div>
                }
            </div>
        </div>
    </form>
</div>

@if (Model.CompletedOrder != null)
{
    <div class="modal fade" id="successModal" tabindex="-1" aria-labelledby="successModalLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-body text-center p-5">
                    <div class="mb-3">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                    </div>

                    <h3 class="fw-bold mb-2" id="successModalLabel">
                        Payment Successful!
                    </h3>

                    <p class="text-muted mb-4">
                        Your order has been created successfully.
                    </p>

                    <h2 class="fw-bold text-success mb-4">
                        ₱@Model.CompletedOrder.TotalAmount.ToString("N2")
                    </h2>

                    <p class="small text-muted">
                        Order No. #@Model.CompletedOrder.OrderId
                    </p>

                    <button type="button" id="successOkayButton" class="btn btn-success btn-lg w-100"> Okay </button>
                </div>

            </div>
        </div>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script src="~/js/Cashier/CreateOrders/Index.js" asp-append-version="true"></script>
}