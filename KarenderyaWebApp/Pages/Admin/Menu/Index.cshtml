@page
@model KarenderyaWebApp.Pages.Admin.Menu.IndexModel

@{
    ViewData["Title"] = "Manage Menu";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Manage Menu</h2>
            <p class="text-muted mb-0">Manage food items, prices, and inventory.</p>
        </div>
        <a asp-page="/Admin/Dashboard/Index" class="btn btn-outline-secondary">
            Back to Dashboard
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div id="validationAlert" asp-validation-summary="All" class="alert alert-danger d-none"></div>

    <div class="card shadow-sm mb-4">
        <div class="card-header">
            <strong>Add Food Item</strong>
        </div>
        <div class="card-body">
            <form method="post" asp-page-handler="Add">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="NewFood.Name" class="form-label">Food Name</label>
                        <input asp-for="NewFood.Name" class="form-control" placeholder="e.g. Chicken Adobo" required />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="NewFood.Price" class="form-label">Price (₱)</label>
                        <input asp-for="NewFood.Price" type="number" class="form-control" min="0.01" step="0.01" required />
                    </div>

                    <div class="col-md-3">
                        <label asp-for="NewFood.AvailableQuantity" class="form-label">
                            Initial Stock
                        </label>
                        <input asp-for="NewFood.AvailableQuantity" type="number" class="form-control" min="0" required />
                    </div>

                    <div class="col-md-2 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            Add Item
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <strong>Food Menu</strong>
        </div>
        <div class="card-body">
            @if (Model.FoodItems.Count == 0)
            {
                <p class="text-muted mb-0">No food items found. Add your first menu item above.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Food Name</th>
                                <th>Price</th>
                                <th>Stock</th>
                                <th>Status</th>
                                <th style="min-width: 300px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var food in Model.FoodItems)
                            {
                                <tr>
                                    <td>@food.Name</td>
                                    <td>₱@food.Price.ToString("N2")</td>
                                    <td>@food.AvailableQuantity</td>
                                    <td>
                                        @if (food.IsAvailable && food.AvailableQuantity > 0)
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Unavailable</span>
                                        }
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="Update" class="d-flex flex-wrap gap-2 mb-2">

                                            <input type="hidden" name="FoodItemId" value="@food.FoodItemId" />
                                            <input name="Name" value="@food.Name" class="form-control form-control-sm" style="width: 130px" required />
                                            <input name="Price" value="@food.Price" type="number" min="0.01" step="0.01" class="form-control form-control-sm" style="width: 100px" required />
                                            <input name="AvailableQuantity" value="@food.AvailableQuantity" type="number" min="0" class="form-control form-control-sm" style="width: 80px" required />
                                            
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                Save
                                            </button>
                                        </form>

                                        <form method="post" asp-page-handler="Toggle">
                                            <input type="hidden" name="id" value="@food.FoodItemId" />

                                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                                @(food.IsAvailable ? "Mark Unavailable" : "Mark Available")
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
