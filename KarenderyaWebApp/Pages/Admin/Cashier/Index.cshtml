@page
@model KarenderyaWebApp.Pages.Admin.Cashier.IndexModel

@{
    ViewData["Title"] = "Manage Cashiers";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm text-center p-4">
                <div class="card-body py-5">
                    <div class="mb-4">
                        <i class="bi bi-tools display-3 text-primary"></i>
                    </div>

                    <h2 class="fw-bold mb-3">Coming Soon!</h2>

                    <p class="text-muted mb-4">
                        The Manage Cashiers feature is currently under development.
                        We're working to bring you this functionality in a future update.
                    </p>

                    <a asp-page="/Admin/Dashboard/Index"
                       class="btn btn-primary">
                        <i class="bi bi-arrow-left me-2"></i>
                        Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
